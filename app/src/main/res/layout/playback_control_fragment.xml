<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@android:color/transparent"
    android:orientation="horizontal">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/image_button_backgroud"
        app:layout_constraintStart_toStartOf="@id/playPause"
        app:layout_constraintEnd_toEndOf="@id/playPause"
        app:layout_constraintTop_toTopOf="@id/playPause"
        app:layout_constraintBottom_toBottomOf="@id/playPause"/>

    <com.example.tagplayer.core.CustomImageButton
        android:id="@+id/playPause"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:backgroundTintMode="src_in"
        android:background="@drawable/placeholder_playback"
        android:src="@drawable/ic_play_with_bg"
        app:layout_constraintBottom_toTopOf="@id/timeBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.tagplayer.core.CustomTextView
        android:id="@+id/songTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:freezesText="true"
        android:gravity="start|bottom"
        app:layout_constraintVertical_weight="1"
        android:background="@android:color/transparent"
        android:textAppearance="@style/PlaybackControlSongTitleText"
        app:layout_constraintBottom_toTopOf="@+id/padding"
        app:layout_constraintEnd_toStartOf="@id/rewindSong"
        app:layout_constraintStart_toEndOf="@id/playPause"
        app:layout_constraintTop_toTopOf="@+id/playPause"
        tools:text="@string/nothing_is_playing"/>

    <View
        android:id="@+id/padding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintVertical_weight="0.2"
        app:layout_constraintTop_toBottomOf="@id/songTitle"
        app:layout_constraintStart_toEndOf="@id/playPause"
        app:layout_constraintEnd_toStartOf="@id/rewindSong"
        app:layout_constraintBottom_toTopOf="@id/songAuthor"/>

    <TextView
        android:id="@+id/songAuthor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:singleLine="true"
        app:layout_constraintVertical_weight="1"
        android:layout_marginHorizontal="12dp"
        android:background="@android:color/transparent"
        android:freezesText="true"
        android:gravity="start|top"
        android:textAppearance="@style/PlaybackControlSongAuthorText"
        app:layout_constraintBottom_toBottomOf="@id/playPause"
        app:layout_constraintEnd_toStartOf="@id/rewindSong"
        app:layout_constraintStart_toEndOf="@id/playPause"
        app:layout_constraintTop_toBottomOf="@+id/padding"
        tools:text="Song author" />

    <ImageButton
        android:id="@+id/rewindSong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="-2dp"
        android:layout_marginHorizontal="18dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/restart_current_song"
        android:src="@drawable/ic_reset"
        app:layout_constraintBottom_toTopOf="@id/timeBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@+id/timeBar"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:scrubber_color="@color/dark"
        app:played_color="@color/dark"
        app:unplayed_color="@color/soft_dark"/>

</androidx.constraintlayout.widget.ConstraintLayout>
