<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseFragmentViewStyle">
        <item name="android:background">?android:attr/colorPrimary</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="TagsRecycler">
        <item name="layoutManager">com.google.android.flexbox.FlexboxLayoutManager</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:colorBackground">?android:attr/colorPrimary</item>
        <item name="minWidth">0dp</item>
        <item name="android:textAppearance">@style/H4Text</item>
        <item name="android:textColor">?attr/textThemeColor</item>
    </style>

    <style name="RoundedSquare">
        <item name="cornerSize">10%</item>
        <item name="strokeColor">?attr/textThemeColor</item>
    </style>

    <style name="PickerRoundedSquare">
        <item name="android:padding">0.75dp</item>
        <item name="strokeColor">@color/dark</item>
        <item name="strokeWidth">0.75dp</item>
    </style>

    <style name="PickedColor" parent="PickerRoundedSquare">
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="shapeAppearanceOverlay">@style/RoundedSquare</item>
    </style>

    <style name="TagTextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/background_tag</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="TagTextViewPlayback" parent="TagTextView">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="EditTextStyle" parent="ThemeOverlay.Material3.TextInputEditText">
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColorHint">?attr/hintTextColor</item>
        <item name="android:textColor">?attr/textThemeColor</item>
        <item name="fontFamily">@font/raleway_regular_400</item>
    </style>

    <style name="SearchEditTextStyle" parent="EditTextStyle">
        <item name="android:background">@drawable/background_edittext_search</item>
        <item name="android:drawableLeft">@drawable/ic_search</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:hint">@string/hint_search</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

</resources>