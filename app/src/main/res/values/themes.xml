<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TagPlayer" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
    </style>

    <style name="Theme.TagPlayer" parent="Base.Theme.TagPlayer" />

    <style name="H1Text" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/raleway_semibold_600</item>
    </style>

    <style name="H2Text" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/raleway_regular_400</item>
    </style>

    <style name="PlaybackControlSongTitleText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/raleway_semibold_600</item>
    </style>

    <style name="PlaybackControlSongAuthorText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/raleway_regular_400</item>
    </style>

    <style name="CustomCardView" parent="Widget.MaterialComponents.CardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay_card_custom_corners</item>
        <item name="backgroundTint">@color/white</item>
    </style>
    
    <style name="TagTextView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/oval_background</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="CustomScrollBar">
        <item name="android:scrollbars">vertical</item>
        <item name="android:scrollbarThumbVertical">@drawable/scroller_thumb</item>
    </style>

    <style name="TagTextViewSelected" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">12sp</item>
        <item name="android:background">@drawable/oval_background_filled</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_margin">2dp</item>
    </style>
    
    <style name="ShapeAppearanceOverlay_card_custom_corners" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:background">@drawable/searchview_background</item>
        <item name="queryBackground">@android:color/transparent</item>
        <item name="iconifiedByDefault">false</item>
        <item name="queryHint">@string/query_hint</item>
        <item name="searchIcon">@drawable/ic_search</item>
        <item name="android:paddingStart">-8dp</item>
    </style>
    
    <drawable name="media3_notification_seek_to_previous">@drawable/ic_restart</drawable>
    <drawable name="media3_notification_play">@drawable/ic_play</drawable>
    <drawable name="media3_notification_pause">@drawable/ic_pause</drawable>

</resources>