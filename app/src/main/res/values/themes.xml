<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.V21.Light.Theme.TagPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="mainAccent">@color/accent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecond">@color/colorSecondary</item>
        <item name="textThemeColor">@color/textThemeColor</item>
        <item name="hintTextColor">@color/hintColor</item>

        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="imageButtonStyle">@style/ImageButtonStyle</item>
    </style>

    <style name="Base.Theme.TagPlayer" parent="Base.V21.Light.Theme.TagPlayer" />

    <drawable name="media3_notification_seek_to_previous">@drawable/ic_refresh_notification</drawable>
    <drawable name="media3_notification_play">@drawable/ic_play_notification</drawable>
    <drawable name="media3_notification_pause">@drawable/ic_pause_notification</drawable>

</resources>